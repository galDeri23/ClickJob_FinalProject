<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ClickJob_FinalProject" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.ClickJob_FinalProject" parent="Base.Theme.ClickJob_FinalProject" />

    <!-- Base Text Styles -->
    <style name="TextStyle" />
    <style name="TextStyle.Ploni" />
    <style name="TextStyle.Heebo" />

    <!-- Ploni Text Styles -->
    <style name="TextStyle.Ploni.Title">
        <item name="android:fontFamily">@font/ploni_bold_aaa</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#363D49</item>
    </style>

    <style name="TextStyle.Ploni.Subtitle">
        <item name="android:fontFamily">@font/ploni_medium_aaa</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1F1F1F</item>
    </style>

    <style name="TextStyle.Ploni.Caption">
        <item name="android:fontFamily">@font/ploni_regular_aaa</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#8B919E</item>
    </style>

    <!-- Heebo Text Styles -->
    <style name="TextStyle.Heebo.Title">
        <item name="android:fontFamily">@font/heebo_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#363D49</item>
    </style>

    <style name="TextStyle.Heebo.Subtitle">
        <item name="android:fontFamily">@font/heebo_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1F1F1F</item>
    </style>

    <style name="TextStyle.Heebo.Caption">
        <item name="android:fontFamily">@font/heebo_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#8B919E</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TopRoundedImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">18dp</item>
        <item name="cornerSizeTopRight">18dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/ploni_bold_aaa</item>
    </style>
</resources>