<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_marginBottom="10dp"
    android:layoutDirection="ltr"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:padding="14dp">

        <!-- Category image: circle, RIGHT side -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCategory"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/img_cat_circle_hospitality" />

        <!-- Variant 1: QR button - LEFT side -->
        <LinearLayout
            android:id="@+id/btnQr"
            android:layout_width="40dp"
            android:layout_height="42dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_qr_button"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/scan"
                app:tint="#FFFFFF"
                android:contentDescription="QR" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Variant 2: Timer - LEFT side -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_clock"
            android:drawablePadding="4dp"
            android:drawableTint="@color/DarkDeep"
            android:gravity="center_vertical"
            android:background="@drawable/bg_timer_box"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/DarkDeep"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="4.5 שעה" />

        <!-- Variant 3: Duplicate button - LEFT side (history tab) -->
        <LinearLayout
            android:id="@+id/btnDuplicate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_qr_button"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שכפל"
                android:drawableStart="@drawable/ic_plus"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:drawableTint="@color/white"
                android:textColor="@color/white"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="15dp" />

        </LinearLayout>

        <!-- Job title -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/DarkDeep"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textSize="18sp"
            android:gravity="start"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnQr"
            app:layout_constraintEnd_toStartOf="@id/imgCategory"
            tools:text="מלצרית לחתונה" />

        <!-- Company name -->
        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/DarkDeep"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="14sp"
            android:gravity="start"
            android:textDirection="rtl"
            app:layout_constraintTop_toBottomOf="@id/tvJobTitle"
            app:layout_constraintStart_toEndOf="@id/btnQr"
            app:layout_constraintEnd_toStartOf="@id/imgCategory"
            tools:text="שם חברה" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/gray04"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="14sp"
            android:gravity="start"
            android:textDirection="rtl"
            app:layout_constraintTop_toBottomOf="@id/tvCompanyName"
            app:layout_constraintStart_toEndOf="@id/btnQr"
            app:layout_constraintEnd_toStartOf="@id/imgCategory"
            tools:text="₪00/לשעה" />

        <!-- Date -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:drawableEnd="@drawable/ic_clock"
            android:drawablePadding="3dp"
            android:drawableTint="@color/gray04"
            android:gravity="start|center_vertical"
            android:textColor="@color/gray04"
            android:textDirection="rtl"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvPrice"
            app:layout_constraintStart_toEndOf="@id/btnQr"
            app:layout_constraintEnd_toStartOf="@id/imgCategory"
            tools:text="מחר" />

        <!-- Bottom row: workers count + progress bar -->
        <LinearLayout
            android:id="@+id/bottomRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/imgCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tvDate"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Workers count -->
            <TextView
                android:id="@+id/tvWorkersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray04"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                tools:text="7/7" />

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/progressWorkers"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/progress_bar_teal" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>