<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layoutDirection="rtl"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Category image: circle, RIGHT side -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCategory"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@drawable/img_cat_circle_hospitality" />

        <!-- Job title -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="#24061E"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="@id/imgCategory"
            app:layout_constraintStart_toEndOf="@id/imgCategory"
            app:layout_constraintEnd_toStartOf="@id/btnQr"
            tools:text="מלצרית לחתונה" />

        <!-- Date and price -->
        <TextView
            android:id="@+id/tvDatePrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="#888888"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tvJobTitle"
            app:layout_constraintStart_toEndOf="@id/imgCategory"
            app:layout_constraintEnd_toStartOf="@id/btnQr"
            tools:text="תאריך · 88.88 ₪/שעה" />

        <!-- QR button: LEFT side, "staffed" (מאוישות) tab only -->
        <LinearLayout
            android:id="@+id/btnQr"
            android:layout_width="48dp"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_qr_button"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomRow">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/scan"
                app:tint="#FFFFFF"
                android:contentDescription="QR" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="QR"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- Timer: LEFT side, "in progress" (בטיפול) tab only -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_clock"
            android:drawablePadding="4dp"
            android:drawableTint="#888888"
            android:gravity="center_vertical"
            android:background="@drawable/bg_timer_box"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="#888888"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="17:50:54" />

        <!-- "Handled" badge: LEFT side, history tab only -->
        <LinearLayout
            android:id="@+id/btnHandled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_handled_button"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שכפל"
                android:textColor="#888888"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_status_check"
                app:tint="#888888"
                android:contentDescription="שכפל" />

        </LinearLayout>

        <!-- Bottom row: workers count + progress bar -->
        <LinearLayout
            android:id="@+id/bottomRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/imgCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Progress bar: fills remaining space -->
            <ProgressBar
                android:id="@+id/progressWorkers"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/progress_bar_teal" />

            <!-- Workers count: RIGHT side of bottom row -->
            <TextView
                android:id="@+id/tvWorkersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#68BAC6"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                tools:text="7/7" />


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>