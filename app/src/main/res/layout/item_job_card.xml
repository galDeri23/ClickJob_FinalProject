<?xml version="1.0" encoding="utf-8"?>
<!-- Job card ("Best match" / "Urgent" sections) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJob"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="false"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Job image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgJob"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/TopRoundedImageStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/img_cat_security" />

        <!-- Category chip: top-left corner of the image -->
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_category_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:maxLines="1"
            android:fontFamily="@font/heebo_medium"
            app:layout_constraintTop_toTopOf="@id/imgJob"
            app:layout_constraintStart_toStartOf="@id/imgJob"
            tools:text="אבטחה וביטחון" />

        <!-- Company avatar: below the image, RIGHT side -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCompanyAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintTop_toBottomOf="@id/imgJob"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@tools:sample/avatars" />

        <!-- Match progress ring: below image, LEFT side -->
        <FrameLayout
            android:id="@+id/layoutMatch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/imgJob"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:id="@+id/progressMatch"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="90"
                android:progressDrawable="@drawable/progress_ring" />

            <TextView
                android:id="@+id/tvMatchPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/brand_pink"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="90%" />
        </FrameLayout>

        <!-- Job title: between avatar and match ring, right-aligned -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/imgJob"
            app:layout_constraintStart_toEndOf="@id/imgCompanyAvatar"
            app:layout_constraintEnd_toStartOf="@id/layoutMatch"
            tools:text="שם משרה" />

        <!-- Company name -->
        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/heebo_medium"
            app:layout_constraintTop_toBottomOf="@id/tvJobTitle"
            app:layout_constraintStart_toEndOf="@id/imgCompanyAvatar"
            app:layout_constraintEnd_toStartOf="@id/layoutMatch"
            tools:text="הפקות EventPro" />

        <!-- Price row: directly under company name, same column -->
        <LinearLayout
            android:id="@+id/layoutPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvCompanyName"
            app:layout_constraintStart_toEndOf="@id/imgCompanyAvatar"
            app:layout_constraintEnd_toStartOf="@id/layoutMatch">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textColor="@color/brand_pink"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="₪50" />

            <TextView
                android:id="@+id/tvPerHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_gray"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="9sp"
                tools:text="לשעה" />


        </LinearLayout>

        <!-- Divider line: below price row AND avatar/match ring (whichever is taller) -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/layoutPrice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom info row: equally spaced -->
        <LinearLayout
            android:id="@+id/bottomInfoRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/text_gray" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_gray"
                    android:fontFamily="@font/ploni_regular_aaa"
                    android:textSize="13sp"
                    android:maxLines="1"
                    tools:text="2.2 ק&quot;מ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_gray" />

                <TextView
                    android:id="@+id/tvDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:fontFamily="@font/ploni_regular_aaa"
                    tools:text="מחר" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/text_gray" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_gray"
                    android:fontFamily="@font/ploni_regular_aaa"
                    android:textSize="13sp"
                    android:maxLines="1"
                    tools:text="4.7" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>