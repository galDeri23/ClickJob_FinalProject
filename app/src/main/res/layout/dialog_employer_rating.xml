<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:padding="20dp"
    android:background="@drawable/bg_card_rounded">

    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvRatingQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="כמה אתה מרוצה מחווית העבודה של רום פז?"
        android:textSize="18sp"
        android:fontFamily="@font/ploni_bold_aaa"
        android:textColor="@color/DarkDeep"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvShiftDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="עבודה ביום שני 23.03.26 19:00-21:00"
        android:textSize="14sp"
        android:fontFamily="@font/ploni_regular_aaa"
        android:textColor="@color/gray04"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvRatingQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgWorker"
        android:layout_width="94dp"
        android:layout_height="94dp"
        android:layout_marginTop="18dp"
        android:scaleType="centerCrop"
        android:src="@drawable/user"
        app:shapeAppearanceOverlay="@style/CircleImageStyle"
        app:layout_constraintTop_toBottomOf="@id/starsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/starsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvShiftDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star_outline"
            android:layout_marginHorizontal="4dp"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/star2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star_outline"
            android:layout_marginHorizontal="4dp"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/star3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star_outline"
            android:layout_marginHorizontal="4dp"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/star4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star_outline"
            android:layout_marginHorizontal="4dp"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/star5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star_outline"
            android:layout_marginHorizontal="4dp"
            android:padding="4dp"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitRating"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="שלח"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:fontFamily="@font/ploni_medium_aaa"
        app:backgroundTint="#68BAC6"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/imgWorker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>