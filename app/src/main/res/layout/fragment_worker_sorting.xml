<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="מיון עובדים"
        android:textSize="30sp"
        android:fontFamily="@font/ploni_bold_aaa"
        android:textColor="#1C1C1C"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_forward"
        android:padding="8dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_icon_btn"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Job card (reused, no progress bar) -->
    <include
        android:id="@+id/jobCard"
        layout="@layout/item_employer_job_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <LinearLayout
        android:id="@+id/llStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/jobCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvAppliedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="כמה אני צריך: 15"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="@color/DarkDeep"/>



        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/tvNeededCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="כמה הגישו: 5"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="@color/DarkDeep"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Filter icon + Tabs row -->
    <LinearLayout
        android:id="@+id/llTabsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/llStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    <!-- Tabs container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/bg_outline_tabs_container"
        android:padding="3dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/tabApplied"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="הגישו (20)"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/bg_tab_selected_teal"/>

        <TextView
            android:id="@+id/tabAccepted"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="התקבלו (3)"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="@color/DarkDeep"
            android:gravity="center"
            android:background="@drawable/bg_tab_unselected_sorting"/>

    </LinearLayout>
    </LinearLayout>

    <!-- Workers list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/llTabsRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>