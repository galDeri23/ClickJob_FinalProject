<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F3F4"
    android:layoutDirection="rtl">

    <!-- Bottom buttons row: employer profile + address pills + apply button -->

    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Employer profile + address pills in one row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:weightSum="2">

            <!-- אתר מעסיק -->
            <LinearLayout
                android:id="@+id/btnEmployerProfile"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@color/white"
                android:gravity="center"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="אתר מעסיק"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:fontFamily="@font/ploni_regular_aaa"/>

            </LinearLayout>

            <!-- כתובת -->
            <LinearLayout
                android:id="@+id/btnAddress"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/text_dark"/>

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="כתובת"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:fontFamily="@font/ploni_regular_aaa"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Apply button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="הגשת מועמדות/אישור עבודה"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/ploni_bold_aaa"
            app:backgroundTint="@color/brand_pink"
            app:cornerRadius="12dp"/>

    </LinearLayout>

    <!-- Scrollable content -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/imgHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/wat_img"/>

                <!-- Back -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_icon_btn"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_forward"/>

                <!-- Favorite -->
                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_icon_btn"
                    android:padding="12dp"
                    android:src="@drawable/bookmark"/>

                <!-- Share -->
                <ImageButton
                    android:id="@+id/btnShare"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="64dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_icon_btn"
                    android:padding="12dp"
                    android:src="@drawable/share"/>

            </FrameLayout>

            <!-- Business Card: logo + name/category (right), price box (left) -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-28dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Logo + name group: right side together -->
                    <LinearLayout
                        android:id="@+id/logoNameGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <!-- Logo -->
                        <ImageView
                            android:id="@+id/imgLogo"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/wat_san"
                            android:background="@drawable/bg_circle_logo"
                            android:clipToOutline="true"
                            android:scaleType="centerCrop"/>

                        <!-- Company name + category -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/tvCompanyName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="wat-san"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/ploni_bold_aaa"
                                android:textColor="@color/text_dark"/>

                            <TextView
                                android:id="@+id/tvCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="מסעדנות ואירוח"
                                android:textSize="13sp"
                                android:textColor="@color/text_gray"
                                android:fontFamily="@font/ploni_regular_aaa"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Price box: left side -->
                    <LinearLayout
                        android:id="@+id/priceBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_price_box"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₪50"
                            android:textColor="@color/brand_pink"
                            android:textSize="22sp"
                            android:fontFamily="@font/ploni_bold_aaa"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="לשעה"
                            android:textColor="@color/brand_pink"
                            android:textSize="11sp"
                            android:fontFamily="@font/ploni_regular_aaa"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Timing Card: single card with clock icon + days/hours rows -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layoutDirection="rtl">

                    <!-- Header row: clock icon + "תיזמון" label, right-aligned -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/text_dark"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="תיזמון"
                            android:textSize="16sp"
                            android:fontFamily="@font/ploni_bold_aaa"
                            android:textColor="@color/text_dark"/>

                    </LinearLayout>

                    <!-- Day rows: each row = day name (right) + hours (left) -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tvDay1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ראשון 10:00-20:00"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:fontFamily="@font/ploni_regular_aaa"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tvDay2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="חמישי 9:00-16:00"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:fontFamily="@font/ploni_regular_aaa"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDay3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="שבת 9:00-13:00"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:fontFamily="@font/ploni_regular_aaa"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Job Type -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                android:text="אופי משרה"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:text="קבוע, 3 משמרות בשבוע"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="14sp"
                android:textColor="@color/text_gray"/>

            <!-- Requirements -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                android:text="דרישות"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRequirements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"/>

            <!-- Description -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                android:text="תיאור עבודה"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:textAlignment="viewStart"
                android:fontFamily="@font/ploni_regular_aaa"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp"
                android:text="דרושים עובדי צוות למסעדה אסיאתית [שם העיר] למשמרות בוקר וערב גמישות. המשמרת כוללת קבלת קהל, לקיחת הזמנות, אריזת משלוחים (לוודא רטבים וצ׳ופסטיקס), הגשת מנות ושמירה על ניקיון ואסתטיקה של המקום."
                android:textColor="#9C8F9A"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>