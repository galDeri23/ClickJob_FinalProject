<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl">

    <!-- Title: right side -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="התראות"
        android:textColor="@color/DarkDeep"
        android:textSize="32sp"
        android:fontFamily="@font/ploni_bold_aaa"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Search icon: left side -->
    <ImageView
        android:id="@+id/ivSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_search"
        android:background="@drawable/bg_back_button"
        android:padding="8dp"
        android:elevation="5dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Search" />

    <!-- Worker / Employer toggle: centered -->
    <LinearLayout
        android:id="@+id/toggleContainer"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:background="@drawable/bg_toggle_container"
        android:padding="3dp"
        android:visibility="gone"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/toggleWorker"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="עובד"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_toggle_selected" />

        <TextView
            android:id="@+id/toggleEmployer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="מעסיק"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="#888888"
            android:background="@android:color/transparent" />

    </LinearLayout>

    <!-- Notifications list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toggleContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_notification_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>