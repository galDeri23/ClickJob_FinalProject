<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layoutDirection="rtl"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Category image: circle, right side -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCategory"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@drawable/img_cat_circle_creative" />

        <!-- Approve button: visible only in active tab for first item -->
        <TextView
            android:id="@+id/btnApprove"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="אשר ←"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:background="@drawable/bg_approve_button"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Timer: visible only in pending tab -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="4dp"
            android:drawableTint="@color/text_gray"
            android:gravity="center_vertical"
            android:textColor="@color/text_gray"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="01:17:50:54" />

        <!-- Job title -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="#24061E"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgCategory"
            app:layout_constraintEnd_toStartOf="@id/btnApprove"
            tools:text="שם משרה" />

        <!-- Company name -->
        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/black"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvJobTitle"
            app:layout_constraintStart_toEndOf="@id/imgCategory"
            app:layout_constraintEnd_toStartOf="@id/btnApprove"
            tools:text="שם חברה" />

        <!-- Info row: distance / day / price -->
        <LinearLayout
            android:id="@+id/infoRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tvCompanyName"
            app:layout_constraintStart_toEndOf="@id/imgCategory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_search"
                android:gravity="center_vertical"
                android:textColor="@color/text_search"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="12sp"
                tools:text="2.2 ק״מ" />

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_search"
                android:gravity="center_vertical"
                android:textColor="@color/text_search"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="12sp"
                tools:text="מחר" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_search"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="12sp"
                tools:text="50 ש h/00" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>