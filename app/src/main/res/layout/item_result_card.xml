<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layoutDirection="rtl"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Company image: circle, right side -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/tvCategory"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@drawable/img_cat_circle_creative" />

        <!-- Job title -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="#24061E"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvCategory"
            app:layout_constraintEnd_toStartOf="@id/layoutPrice"
            tools:text="שם משרה" />

        <!-- Company name -->
        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="#888888"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvJobTitle"
            app:layout_constraintStart_toEndOf="@id/tvCategory"
            app:layout_constraintEnd_toStartOf="@id/layoutPrice"
            tools:text="שם חברה" />

        <!-- Price block: left side -->
        <LinearLayout
            android:id="@+id/layoutPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/infoRow">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textColor="@color/brand_pink"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textSize="20sp"
                tools:text="₪50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לשעה"
                android:textColor="#888888"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Bottom info row: distance / day / rating -->
        <LinearLayout
            android:id="@+id/infoRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tvCompanyName"
            app:layout_constraintStart_toEndOf="@id/tvCategory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_search"
                android:gravity="center_vertical"
                android:textColor="@color/text_search"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="13sp"
                tools:text="2.2 ק״מ" />

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_search"
                android:gravity="center_vertical"
                android:textColor="@color/text_search"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="13sp"
                tools:text="מחר" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_search"
                android:gravity="center_vertical"
                android:textColor="@color/text_search"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="13sp"
                tools:text="4.7" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>