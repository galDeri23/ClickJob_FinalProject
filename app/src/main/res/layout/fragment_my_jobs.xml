<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="המשרות שלי"
        android:textColor="@color/DarkDeep"
        android:textSize="32sp"
        android:fontFamily="@font/ploni_bold_aaa"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Worker / Employer toggle: hidden by default, shown only when user clicks "post job" -->
    <LinearLayout
        android:id="@+id/toggleContainer"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:background="@drawable/bg_toggle_container"
        android:padding="3dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/toggleWorker"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="עובד"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_toggle_selected" />

        <TextView
            android:id="@+id/toggleEmployer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="מעסיק"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="#888888"
            android:background="@android:color/transparent" />

    </LinearLayout>


    <!-- Tabs row: 2 tabs only -->
    <LinearLayout
        android:id="@+id/tabsRow"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tabs_container"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabActive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="פעילות"
            android:gravity="center"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_selected" />

        <TextView
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="היסטוריה"
            android:gravity="center"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="#24061E"
            android:background="@drawable/bg_tab_unselected_box" />

    </LinearLayout>

    <!-- Post job button: shown only in employer mode -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPostJob"
        android:layout_width="161dp"
        android:layout_height="41dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tabsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:layoutDirection="ltr">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:fontFamily="@font/ploni_bold_aaa"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="פרסום עבודה"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:fontFamily="@font/ploni_bold_aaa" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Empty state card: shown in employer mode when no jobs exist -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmptyHistory"
        android:layout_width="0dp"
        android:layout_height="221dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tabsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr">

            <ImageView
                android:id="@+id/imgEmptyCharacter"
                android:layout_width="74dp"
                android:layout_height="155dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="28dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img_rating_character"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.508" />

            <TextView
                android:id="@+id/tvEmptyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="עדיין לא פרסמת משרה ראשונה?\nבואו ניצור ביחד "
                android:textColor="@color/black"
                android:textSize="17sp"
                android:fontFamily="@font/ploni_medium_aaa"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvEmptyPlus"
                app:layout_constraintEnd_toStartOf="@id/imgEmptyCharacter" />

            <ImageView
                android:id="@+id/tvEmptyPlus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="end"
                android:layout_marginStart="28dp"
                android:src="@drawable/plus"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:fontFamily="@font/ploni_bold_aaa"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Jobs list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJobs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/cardPostJob"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>