<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl">

    <!-- Title: right side -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="המשרות שלי"
        android:textColor="#24061E"
        android:textSize="22sp"
        android:fontFamily="@font/ploni_bold_aaa"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Worker / Employer toggle: left side -->
    <LinearLayout
        android:id="@+id/toggleContainer"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:background="@drawable/bg_toggle_container"
        android:padding="3dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/toggleWorker"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="עובד"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_toggle_selected" />

        <TextView
            android:id="@+id/toggleEmployer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="מעסיק"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="#888888"
            android:background="@android:color/transparent" />

    </LinearLayout>

    <!-- Search bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_search_bar"
        android:drawableEnd="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:gravity="end|center_vertical"
        android:hint="חיפוש תפקיד, עסק או אזור"
        android:textColorHint="#AAAAAA"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp"
        android:fontFamily="@font/ploni_regular_aaa"
        android:inputType="text"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tabs row -->
    <LinearLayout
        android:id="@+id/tabsRow"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tabs_container"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabActive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="פעילות (3)"
            android:gravity="center"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_selected" />

        <TextView
            android:id="@+id/tabPending"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="בהמתנה (0)"
            android:gravity="center"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="#24061E"
            android:background="@drawable/bg_tab_unselected_box" />

        <TextView
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="היסטוריה"
            android:gravity="center"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="#24061E"
            android:background="@drawable/bg_tab_unselected_box" />

    </LinearLayout>

    <!-- "Post job" button - shown at top of employer history list ONLY when history exists.
         Tapping it opens the PostJobFragment for a new (empty) job. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPostJob"
        android:layout_width="214dp"
        android:layout_height="33dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tabsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:layoutDirection="ltr">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:fontFamily="@font/ploni_bold_aaa"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="פרסום עבודה"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:fontFamily="@font/ploni_bold_aaa" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Empty state card - shown in employer history tab ONLY when no history exists.
         Tapping it opens PostJobFragment for a new (empty) job. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmptyHistory"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tabsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr">

            <!-- Character illustration on the left -->

            <!-- Text in the middle -->

            <ImageView
                android:id="@+id/imgEmptyCharacter"
                android:layout_width="130dp"
                android:layout_height="150dp"
                android:layout_marginTop="25dp"
                android:contentDescription="@null"
                android:gravity="start"
                android:scaleType="fitCenter"
                android:src="@drawable/img_empty_jobs_character"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tvEmptyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="עדיין לא פרסמתם משרה,\nבוא ניצור את המשרה הראשונה שלך"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:fontFamily="@font/ploni_bold_aaa"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvEmptyPlus"
                app:layout_constraintEnd_toStartOf="@id/imgEmptyCharacter" />


            <!-- "+" icon on the left side -->
            <TextView
                android:id="@+id/tvEmptyPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:gravity="end"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:fontFamily="@font/ploni_bold_aaa"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Jobs list - constrained to cardPostJob when visible, otherwise to tabsRow -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJobs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/cardPostJob"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>