<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:paddingBottom="32dp">

        <!-- Header -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_forward"
            android:background="@drawable/bg_back_button"
            android:padding="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="פרסום משרה"
            android:textSize="34sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Job category -->
        <TextView
            android:id="@+id/tvCategoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="קטגוריית משרה"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvCategoryLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Company -->
        <TextView
            android:id="@+id/tvCompanyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="חברה"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategory"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCompany"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="@color/input_stroke_color"
            app:boxBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/tvCompanyLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Salary -->
        <TextView
            android:id="@+id/tvSalaryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שכר"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tilCompany"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Salary type toggle -->
        <LinearLayout
            android:id="@+id/salaryTypeContainer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:background="@drawable/bg_toggle_container"
            android:padding="3dp"
            android:layout_marginEnd="80dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvSalaryLabel"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/toggleHourly"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="שעתי"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_toggle_selected_teal"/>

            <TextView
                android:id="@+id/toggleDaily"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="יומי"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="#888888"
                android:background="@android:color/transparent"/>

        </LinearLayout>

        <!-- Salary amount -->
        <Spinner
            android:id="@+id/spinnerSalary"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSalaryLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Timing / Calendar -->
        <TextView
            android:id="@+id/tvTimingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="תזמון"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/salaryTypeContainer"
            app:layout_constraintEnd_toEndOf="parent"/>

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/tvTimingLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Hours -->
        <TextView
            android:id="@+id/tvHoursLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שעות"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/calendarView"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Spinner
            android:id="@+id/spinnerEndTime"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvHoursLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.45"/>

        <Spinner
            android:id="@+id/spinnerStartTime"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvHoursLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/spinnerEndTime"
            app:layout_constraintWidth_percent="0.45"/>


        <!-- Workers count -->
        <TextView
            android:id="@+id/tvWorkersLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="כמות עובדים"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerStartTime"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Spinner
            android:id="@+id/spinnerWorkers"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvWorkersLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Job description -->
        <TextView
            android:id="@+id/tvDescriptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="אופי עבודה"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerWorkers"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescription"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="@color/input_stroke_color"
            app:boxBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/tvDescriptionLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="start|top"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:fontFamily="@font/ploni_regular_aaa"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Requirements -->
        <TextView
            android:id="@+id/tvRequirementsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="דרישות"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tilDescription"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Skills chips row -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupRequirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvRequirementsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Phone - full width -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="@color/input_stroke_color"
            app:boxBackgroundColor="@android:color/white"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_phone"
            app:layout_constraintTop_toBottomOf="@id/chipGroupRequirements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:inputType="phone"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Address + Link side by side -->
        <LinearLayout
            android:id="@+id/addressLinkRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tilPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddress"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxStrokeColor="@color/input_stroke_color"
                app:boxBackgroundColor="@android:color/white"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_location">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:inputType="textPostalAddress"
                    android:textSize="14sp"
                    android:fontFamily="@font/ploni_regular_aaa"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Link -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxStrokeColor="@color/input_stroke_color"
                app:boxBackgroundColor="@android:color/white"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_link">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:inputType="textUri"
                    android:textSize="14sp"
                    android:fontFamily="@font/ploni_regular_aaa"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
        <!-- Image upload -->
        <TextView
            android:id="@+id/tvImageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הוסף תמונה"
            android:textSize="14sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/addressLinkRow"
            app:layout_constraintEnd_toEndOf="parent"/>

        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@color/gray04"
            app:layout_constraintTop_toBottomOf="@id/tvImageLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivJobImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/ivAddImageIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add_photo"
                android:layout_gravity="center"/>

        </FrameLayout>


        <!-- Publish button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="פרסם"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="@font/ploni_bold_aaa"
            app:backgroundTint="#68BAC6"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/imageContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>