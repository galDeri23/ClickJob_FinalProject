<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl">

    <!-- Top row: back arrow + step title -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_arrow_forward"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Skip button -->
    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:text="דלג"
        android:textSize="13sp"
        android:fontFamily="@font/ploni_regular_aaa"
        android:textColor="@color/black"
        android:background="@drawable/bg_skip_button"        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvStepTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="26dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="25dp"
        android:text="מי אני ואיפה אני?"
        android:textSize="30sp"
        android:fontFamily="@font/ploni_bold_aaa"
        android:textColor="#1C1C1C"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivBack"
        app:layout_constraintEnd_toStartOf="@+id/tvSkip"/>

    <!-- Registration progress: bar fills right-to-left, percent on the far left -->
    <TextView
        android:id="@+id/tvProgressPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="15%"
        android:textSize="14sp"
        android:fontFamily="@font/ploni_regular_aaa"
        android:textColor="#1C1C1C"
        app:layout_constraintTop_toBottomOf="@+id/tvStepTitle"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progressBarSteps"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:max="100"
        android:progress="15"
        android:progressTint="@color/DarkDeep"
        android:progressBackgroundTint="@color/white"
        app:layout_constraintTop_toTopOf="@+id/tvProgressPercent"
        app:layout_constraintBottom_toBottomOf="@+id/tvProgressPercent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvProgressPercent"/>

    <TextView
        android:id="@+id/tvStepDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:text="ככל שיתקבלו יותר נתונים, כך ההתאמה מדוייקת יותר"
        android:textSize="15sp"
        android:fontFamily="@font/ploni_regular_aaa"
        android:textColor="@color/gray04"
        android:drawableStart="@drawable/ic_warning"
        android:drawableTint="@color/gray04"
        android:drawablePadding="3dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@+id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvProgressPercent"
        app:layout_constraintBottom_toTopOf="@+id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Next button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="371dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:text="הבא"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/ploni_bold_aaa"
        app:backgroundTint="@color/DarkDeep"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>