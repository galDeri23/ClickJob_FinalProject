<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="כניסה/סיום משמרת"
        android:textSize="36sp"
        android:fontFamily="@font/ploni_bold_aaa"
        android:textColor="#4A4A4A"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- White card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardScanner"
        android:layout_width="371dp"
        android:layout_height="432dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Scan label -->
            <TextView
                android:id="@+id/tvScanLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="סריקת ברקוד"
                android:textSize="20sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="@color/DarkDeepPink"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <!-- Grey camera area -->
            <FrameLayout
                android:layout_width="326dp"
                android:layout_height="331dp"
                android:layout_marginTop="22dp"
                android:layout_gravity="center"
                android:background="@color/gray02">

                <!-- Camera preview -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <!-- Pink scan frame on top of camera -->
                <ImageView
                    android:id="@+id/ivScanFrame"
                    android:layout_width="242dp"
                    android:layout_height="242dp"
                    android:src="@drawable/ic_scan_frame"
                    android:layout_gravity="center"/>

            </FrameLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>