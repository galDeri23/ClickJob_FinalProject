<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:layoutDirection="rtl"
        android:textDirection="rtl"
        android:fillViewport="true"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvYourLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="המיקום שלך"
                    android:textColor="@color/text_gray"
                    android:fontFamily="@font/ploni_regular_aaa"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"
                    android:text="נופי הכפר 97, גדרה"
                    android:drawableStart="@drawable/ic_location_point"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/text_dark"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/ploni_bold_aaa"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tvYourLocation"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnPostJob"
                    app:layout_constraintHorizontal_bias="0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPostJob"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="פרסום משרה"
                    android:textSize="13sp"
                    android:fontFamily="@font/ploni_regular_aaa"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/employer_primary"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_plus"
                    app:iconTint="@color/white"
                    app:iconSize="15dp"
                    app:iconGravity="textEnd"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/tvLocation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constrainedWidth="true" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_gray"
                android:paddingHorizontal="14dp"
                android:hint="חיפוש תפקיד, עסק או אזור"
                android:textColorHint="@color/text_gray"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/tvSectionUpcoming"
                style="@style/SectionTitle"
                android:text="המשמרת הקרובה" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpUpcoming"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/layoutDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardNoUpcomingShifts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layoutDirection="ltr"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNoShiftsBg"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="30dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_gradient_blue" />

                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/imgNoShiftsCharacter"
                    android:layout_width="193dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="30dp"
                    android:elevation="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_empty_jobs_character"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/cardNoShiftsBg"
                    app:layout_constraintStart_toStartOf="@id/cardNoShiftsBg" />

                <TextView
                    android:id="@+id/tvNoShiftsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:elevation="4dp"
                    android:text="  מחפשים עבודה להיום?"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/ploni_bold_aaa"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    app:layout_constraintTop_toTopOf="@id/cardNoShiftsBg"
                    app:layout_constraintBottom_toTopOf="@id/tvNoShiftsSubtitle"
                    app:layout_constraintStart_toEndOf="@id/imgNoShiftsCharacter"
                    app:layout_constraintEnd_toEndOf="@id/cardNoShiftsBg"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvNoShiftsSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:elevation="4dp"
                    android:text="   מצאו עבודות בקליק"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/ploni_bold_aaa"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@id/tvNoShiftsTitle"
                    app:layout_constraintBottom_toBottomOf="@id/cardNoShiftsBg"
                    app:layout_constraintStart_toStartOf="@id/tvNoShiftsTitle"
                    app:layout_constraintEnd_toEndOf="@id/tvNoShiftsTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvSectionBestMatch"
                style="@style/SectionTitle"
                android:layout_marginTop="20dp"
                android:text="ההתאמה המיטבית" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBestMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_job_card"
                tools:itemCount="2" />

            <TextView
                android:id="@+id/tvSectionUrgent"
                style="@style/SectionTitle"
                android:layout_marginTop="20dp"
                android:text="דחופים" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUrgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_job_card"
                tools:itemCount="2" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

</FrameLayout>