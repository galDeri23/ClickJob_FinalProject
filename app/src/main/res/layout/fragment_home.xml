<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: header, search, upcoming shift carousel, job lists -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ===== Header: location (right) + post job button (left) ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvYourLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="המיקום שלך"
                android:textColor="@color/text_gray"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawableStart="@drawable/ic_location_point"
                android:drawablePadding="4dp"
                android:drawableTint="@color/text_dark"
                android:gravity="center_vertical"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/ploni_bold_aaa"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvYourLocation"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="נופי הכפר 97, גדרה" />

            <!-- Post job button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostJob"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="פרסום משרה"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="@color/white"
                app:backgroundTint="@color/brand_pink"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                app:iconGravity="textEnd"
                android:paddingHorizontal="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/tvLocation"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== Search bar ===== -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/text_gray"
            android:paddingHorizontal="14dp"
            android:hint="חיפוש תפקיד, עסק או אזור"
            android:textColorHint="@color/text_gray"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch" />

        <!-- ===== Upcoming shift section ===== -->
        <TextView
            android:id="@+id/tvSectionUpcoming"
            style="@style/SectionTitle"
            android:text="המשמרת הקרובה" />

        <!-- Carousel of upcoming shift cards (item_upcoming_shift) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpUpcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"/>

        <!-- Preview-only placeholder: shows the card in the Preview,
     completely hidden (gone) in the real app -->
        <!-- Preview-only placeholder: card + dots, hidden in the real app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <include
                layout="@layout/item_upcoming_shift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/dot_inactive" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/dot_inactive" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/dot_active" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dots indicator - connected to the ViewPager in Kotlin.
             Number of dots = number of open jobs; hidden when there are none -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            app:tabBackground="@drawable/tab_dot_selector"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabPaddingStart="5dp"
            app:tabPaddingEnd="5dp"
            app:tabRippleColor="@null" />

        <!-- ===== Best match section ===== -->
        <TextView
            android:id="@+id/tvSectionBestMatch"
            style="@style/SectionTitle"
            android:layout_marginTop="20dp"
            android:text="ההתאמה המיטבית" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBestMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_job_card"
            tools:itemCount="2" />

        <!-- ===== Urgent section ===== -->
        <TextView
            android:id="@+id/tvSectionUrgent"
            style="@style/SectionTitle"
            android:layout_marginTop="20dp"
            android:text="דחופים" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUrgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_job_card"
            tools:itemCount="2" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>