<?xml version="1.0" encoding="utf-8"?>
<!-- "Upcoming Shift" card -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardUpcomingShift"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="103dp"
        android:padding="14dp">

        <!-- Round image on the right, centered vertically -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgJob"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@drawable/img_cat_circle_creative" />

        <!-- Job title -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgJob"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toTopOf="@id/tvCompanyName"
            tools:text="שם משרה" />

        <!-- Company name -->
        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvJobTitle"
            app:layout_constraintStart_toEndOf="@id/imgJob"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/barrierInfo"
            tools:text="שם חברה" />

        <!-- Barrier so the info row always sits below the company name -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvCompanyName" />

        <!-- Info row: three equal columns so they never collide.
             Each text autosizes to fit its column. -->
        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/barrierInfo"
            app:layout_constraintStart_toEndOf="@id/imgJob"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Address + location icon -->
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="2dp"
                android:drawableTint="@color/text_gray"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/text_gray"
                android:fontFamily="@font/ploni_regular_aaa"
                tools:text="כתובת" />

            <!-- Date + calendar icon -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="5dp"
                android:drawableTint="@color/text_gray"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/text_gray"
                android:fontFamily="@font/ploni_regular_aaa"
                tools:text="dd/mm/yy" />

            <!-- Hours + clock icon -->
            <TextView
                android:id="@+id/tvHours"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="2dp"
                android:drawableTint="@color/text_gray"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/text_gray"
                android:fontFamily="@font/ploni_regular_aaa"
                tools:text="07:00-15:00" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>