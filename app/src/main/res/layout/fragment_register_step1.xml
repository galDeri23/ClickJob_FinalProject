<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Full name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שם ושם משפחה"
            android:textSize="16sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:gravity="start"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="@color/input_stroke_color"
            app:boxBackgroundColor="@android:color/white"
            app:boxStrokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="#333333"
                android:gravity="start"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="טלפון"
            android:textSize="16sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:gravity="start"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxBackgroundColor="@android:color/white"
            app:boxStrokeColor="@color/input_stroke_color"
            app:boxStrokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="#333333"
                android:gravity="end"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- City -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עיר"
            android:textSize="16sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:gravity="start"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerCity"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Address -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="כתובת"
            android:textSize="16sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:gravity="start"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAddress"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxStrokeColor="@color/input_stroke_color"
            app:boxBackgroundColor="@android:color/white"
            app:boxStrokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:textSize="14sp"
                android:fontFamily="@font/ploni_regular_aaa"
                android:textColor="#333333"
                android:gravity="start"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Search radius -->
        <TextView
            android:id="@+id/tvRadiusLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="רדיוס חיפוש (ק״מ)"
            android:textSize="16sp"
            android:fontFamily="@font/ploni_bold_aaa"
            android:textColor="@color/DarkDeep"
            android:gravity="start"
            android:layout_marginBottom="8dp"/>

        <SeekBar
            android:id="@+id/seekBarRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="10"
            android:progressTint="#1C1C1C"
            android:thumbTint="#1C1C1C"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvRadiusValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10 ק״מ"
            android:textSize="13sp"
            android:fontFamily="@font/ploni_regular_aaa"
            android:textColor="#888888"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>